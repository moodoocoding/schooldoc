{
  "name": "schooldoc",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:registry": "vitest run --config vitest.registry-integration.config.ts",
    "test:integration:registry-owner": "vitest run --config vitest.registry-owner.config.ts",
    "test:integration:consent": "vitest run --config vitest.consent-integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "electron:start": "node node_modules/electron/install.js && electron .",
    "electron:build:portable": "node scripts/build-portable.mjs",
    "test:desktop": "node --test tests/desktop/*.test.cjs",
    "test:portable": "node scripts/verify-portable.mjs",
    "test:server-flow": "node scripts/verify-special-room-server.mjs",
    "release:portable": "node scripts/publish-portable.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.26.0",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "read-excel-file": "^9.3.10",
    "tesseract.js": "^7.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "main": "electron/main.cjs",
  "author": "SchoolDoc",
  "description": "SchoolDoc Windows portable"
}
